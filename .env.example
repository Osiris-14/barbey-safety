# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y nunca se sube al repositorio.

# ─── Supabase ──────────────────────────────────────────────
# URL base del proyecto, sin /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esquema de Postgres del que lee la app. Vacío = public.
# Se usa para alojar varios barberos en un mismo Supabase, cada uno en su
# esquema (ver scripts/nuevo-cliente.sql). El esquema debe estar además en
# Settings → API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_SCHEMA=

# ─── UltraMsg (solo servidor, sin NEXT_PUBLIC_) ────────────
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Teléfono del barbero/admin. Recibe un WhatsApp cada vez que alguien agenda.
# Mismo formato que el del cliente: "+1809xxxxxxx"
ADMIN_PHONE=

# ─── Cron de recordatorios ─────────────────────────────────
# El cron externo debe mandarlo como: Authorization: Bearer <secret>
# Generar uno nuevo por cliente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ─── Notificaciones push al barbero ─────────────────────────
# Generar con: npx web-push generate-vapid-keys --json
# La pública es NEXT_PUBLIC_ porque el navegador la necesita al suscribirse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Correo de contacto, ejemplo: mailto:admin@dominio.com
VAPID_SUBJECT=
